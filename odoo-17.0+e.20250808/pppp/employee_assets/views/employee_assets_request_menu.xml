<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_assets_request_menu_action" model="ir.actions.act_window">
        <field name="name">Employee Assets Request</field>
        <field name="res_model">employee.assets.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': True}</field>
    </record>

    <record id="action_employee_assets_assignment_report" model="ir.actions.act_window">
        <field name="name">Asset Assignment Report</field>
        <field name="res_model">employee.assets.request</field>
        <field name="view_mode">tree,pivot</field>
        <field name="domain">[('state','=','assigned')]</field>
        <field name="context">{'create': False,'group_by': ['employee_id']}</field>
    </record>

    <menuitem id="employee_assets_request_menu_root"
              web_icon="employee_assets,static/description/icon.png"
              name="Assets Management"/>
    <menuitem id="employee_assets_request_menu_root" name="Assets Management"/>
    <menuitem id="employee_assets_request_sub_menu" name="Employee Assets Request" sequence="1" parent="employee_assets_request_menu_root" />
    <menuitem id="employee_assets_request_menu" name="Requests" parent="employee_assets_request_sub_menu" sequence="1" action="employee_assets_request_menu_action"/>
    <menuitem id="employee_assets_request_report" name="Report" parent="employee_assets_request_menu_root" sequence="1" />
    <menuitem id="employee_assets_assignment_report_menu" name="Asset Assignment Report" parent="employee_assets_request_report" action="action_employee_assets_assignment_report"/>
</odoo>
