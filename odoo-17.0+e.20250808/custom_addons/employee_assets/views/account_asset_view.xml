<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
         <record id="asset_view_form_asset_type" model="ir.ui.view">
            <field name="name">account.asset.type.form.</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form[1]/sheet[1]/group[1]" position="after">
                    <group name = 'Asset Types'>
                        <field name="asset_serial_no" invisible="state == 'model'" readonly="state != 'draft'"/>
                        <field name="asset_state" invisible="state == 'model'" readonly="state != 'draft'"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
